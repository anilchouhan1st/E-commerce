<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>login</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="/css/password.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="icon" href="/images/A.png">

</head>

<body class="login-body">

    <div class="nav-wrapper">
        <nav class="nav">
            {{> navbar}}
        </nav>
    </div>

    <div class="login-page">
        <div class="login-container">
            <div class="form-box" id="login-form">
                <form id="loginForm" action="/auth/login" method="POST">
                    <input type="hidden" name="_csrf" value="{{csrfToken}}">
                    <h2>Login</h2>
                    <input type="email" name="email" placeholder="Email" required>

                    <div class="password-box">
                        <input type="password" id="password" name="password" placeholder="Password" required>
                        <i class="fa-regular fa-eye toggle-password" data-target="password"></i>
                    </div>

                    <div class="remember-me">
                        <label>
                            <input type="checkbox" name="rememberMe">
                            Remember me
                        </label>
                    </div>

                    <button id="loginBtn" type="submit">Login</button>

                    <div class="forgot">
                        <p id="front-paragraph"><a href="/forgot-password">Forgot password</a></p>
                        <p id="register-paragraph">Don't have an account?<a href="/register">Register</a> </p>
                    </div>


                </form>
            </div>
        </div>
    </div>

    {{> toast}}


    <script src="/js/navbar.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/password-validation.js"></script>
    <script src="/js/password-toggle.js"></script>
    <script src="/js/form-loader.js"></script>

    <script nonce="{{nonce}}">
        setupLoadingButton(
            "loginForm",
            "loginBtn",
            "Signing In..."
        );
    </script>

</body>

</html>